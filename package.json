{
  "name": "vite-plugin-qingkuai",
  "author": "mlgq",
  "license": "MIT",
  "type": "module",
  "version": "1.0.31",
  "packageManager": "pnpm@9.9.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingkuai-js/vite-plugin.git"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "scripts": {
    "dev": "rollup -c -w",
    "test": "vitest --run",
    "release": "tsx scripts/release.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "rimraf dist && tsc -p tsconfig.build.json && rollup -c && rimraf dist/temp-types",
    "postpublish": "curl -X PUT 'https://registry-direct.npmmirror.com/-/package/vite-plugin-qingkuai/syncs'"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.14",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "qingkuai": "^1.0.104",
    "rimraf": "^6.0.1",
    "rollup": "^4.38.0",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "~4.20.6",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "qingkuai": ">=1.0.104",
    "vite": ">=6.2.4 <9"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.0",
    "lines-and-columns": "^2.0.4",
    "postcss": "^8.5.3",
    "postcss-selector-parser": "^7.1.0",
    "qingkuai-language-service": "^1.0.23",
    "source-map-js": "^1.2.1"
  },
  "keywords": [
    "vite",
    "qingkuai",
    "vite plugin",
    "vite-plugin"
  ]
}
